---
import archivo from '../assets/fonts/archivo.woff2?url';
import plex400 from '../assets/fonts/plex-mono-400.woff2?url';
import plex500 from '../assets/fonts/plex-mono-500.woff2?url';
import plex600 from '../assets/fonts/plex-mono-600.woff2?url';
import '../styles/fonts.css';
import '../styles/fallback.css';
import '../styles/global.css';
import BookingForm from '../components/BookingForm.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Nav from '../components/Nav.astro';
import { ph, site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path under /public for the social card. */
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = site.title,
  description = site.description,
  image = '/og.png',
  noindex = false,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;

// An Organization, not a ProfessionalService: that's a kind of LocalBusiness, which Google expects to
// have a street address, and Neurokov works online. The logo is the 180px PNG: Google wants a raster
// image of at least 112px.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: new URL('/apple-touch-icon.png', site.url).href,
  description: site.description,
  areaServed: 'Worldwide',
  email: site.email,
  founder: { '@type': 'Person', name: site.founder.name, jobTitle: site.founder.role },
};
const structured = [organization, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];

// The next page is ready before the click: a link to another page of the site is loaded and laid
// out (prerendered) as the pointer rests on it or a finger presses it, so it opens at once. The
// browser does it, no script to download: Chrome and Edge, while other browsers just follow the
// link. Not the booking buttons, which open the form where the visitor is.
const speculation = {
  prerender: [
    {
      where: { and: [{ href_matches: '/*' }, { not: { selector_matches: '[data-book]' } }] },
      eagerness: 'moderate',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* A page kept out of search (the 404) names no canonical: its own address isn't a page at all. */}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f2efe8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* The web fonts every page uses, for the head script below to fetch early when they're cached. */}
    <meta name="nk-fonts" content={[archivo, plex400, plex500, plex600].join(' ')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ph('domain') && <meta name="nk-placeholder" content="Canonical domain not confirmed" data-ph={ph('domain')} />}

    {/* Every < escaped, so no text in the data can ever close this script tag early. */}
    <script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, '\\u003c')} />
    <script is:inline type="speculationrules" set:html={JSON.stringify(speculation)} />

    <!-- Runs before first paint: the theme (light unless the visitor chose dark) and reduced motion. -->
    <script is:inline>
      (function () {
        var r = document.documentElement;
        r.classList.add('js');
        // Work that can wait until the first screen is up (r.nkLater(fn): the fonts below, the site's
        // script): once the page has loaded and its first paint has reached the screen (as the browser
        // reports it), and two frames more. Nothing then competes with the first screen for the
        // connection or holds up its paint.
        var later = [];
        var loaded = false;
        var painted = !(window.PerformanceObserver && (PerformanceObserver.supportedEntryTypes || []).indexOf('paint') >= 0);
        var flush = function () {
          if (!loaded || !painted || !later) return;
          var fns = later;
          later = null;
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              setTimeout(function () {
                fns.forEach(function (fn) {
                  fn();
                });
              });
            });
          });
        };
        r.nkLater = function (fn) {
          later ? later.push(fn) : fn();
        };
        if (!painted) {
          new PerformanceObserver(function (list, observer) {
            if (!list.getEntriesByName('first-contentful-paint').length) return;
            observer.disconnect();
            painted = true;
            flush();
          }).observe({ type: 'paint', buffered: true });
        }
        addEventListener('load', function () {
          // Content waits hidden for the site's script to reveal it. If that script hasn't claimed the
          // page by now (it failed to download, or the browser is too old for it), show the page as it
          // reads without JavaScript instead of leaving it blank.
          if (!r.hasAttribute('data-ready')) r.classList.remove('js');
          loaded = true;
          flush();
        });
        try {
          if (localStorage.getItem('nk-theme') === 'dark') r.dataset.theme = 'dark';
        } catch (e) {}
        if (r.dataset.theme === 'dark') {
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', '#0f0f0e');
        }
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) r.classList.add('calm');
        // The web fonts (global.css). The page first paints in fonts the visitor already has, sized to
        // take the same room, and these swap in without moving anything. On a first visit they're
        // fetched once the first screen is up (nkLater), so it doesn't share the connection with 70 KB
        // of fonts, and they swap in together when all have arrived; on a later one they're in the
        // browser's cache, so they're fetched now and used from the first paint.
        var fonts = function () {
          r.classList.add('fonts');
        };
        var cached = false;
        try {
          cached = !!localStorage.getItem('nk-fonts');
        } catch (e) {}
        if (cached || !document.fonts) {
          document
            .querySelector('meta[name="nk-fonts"]')
            .content.split(' ')
            .forEach(function (href) {
              var l = document.createElement('link');
              l.rel = 'preload';
              l.as = 'font';
              l.type = 'font/woff2';
              l.crossOrigin = '';
              l.href = href;
              document.head.appendChild(l);
            });
          fonts();
        } else {
          r.nkLater(function () {
            var faces = ['1em "Archivo Variable"', '1em "IBM Plex Mono"', '500 1em "IBM Plex Mono"', '600 1em "IBM Plex Mono"'];
            Promise.all(
              faces.map(function (f) {
                return document.fonts.load(f);
              }),
            ).then(function () {
              fonts();
              try {
                localStorage.setItem('nk-fonts', '1');
              } catch (e) {}
            }, fonts);
          });
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BookingForm mode="dialog" />
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch between light and dark mode">
      <Icon name="sun" class="icon-sun" size={18} />
      <Icon name="moon" class="icon-moon" size={18} />
    </button>
    <div class="ruler" data-ruler aria-hidden="true">
      <span class="ruler__track"><span class="ruler__fill"></span></span>
      <span class="ruler__read" data-ruler-read>000</span>
    </div>
    {/* Netlify adds a "Powered by Netlify" badge script to every page it serves (/.netlify/scripts/hud).
        It builds the badge in a frame whose inline script the Content-Security-Policy blocks, which
        logs an error on every page. The script stands down when a frame by this name is already on
        the page, so this empty one keeps it from trying. Turning the badge off in Netlify's project
        settings, where the plan allows it, stops the script being sent at all. */}
    <template id="nl-badge-frame"></template>
    <script>
      import '../scripts/boot.ts';
    </script>
  </body>
</html>
