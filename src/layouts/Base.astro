---
import archivo from '../assets/fonts/archivo.woff2?url';
import plex400 from '../assets/fonts/plex-mono-400.woff2?url';
import plex500 from '../assets/fonts/plex-mono-500.woff2?url';
import plex600 from '../assets/fonts/plex-mono-600.woff2?url';
import '../styles/fonts.css';
import '../styles/global.css';
import BookingForm from '../components/BookingForm.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Nav from '../components/Nav.astro';
import { ph, site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path under /public for the social card. */
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = site.title,
  description = site.description,
  image = '/og.png',
  noindex = false,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;

// An Organization, not a ProfessionalService: that's a kind of LocalBusiness, which Google expects to
// have a street address, and Neurokov works online. The logo is the 180px PNG: Google wants a raster
// image of at least 112px.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: new URL('/apple-touch-icon.png', site.url).href,
  description: site.description,
  areaServed: 'Worldwide',
  email: site.email,
  founder: { '@type': 'Person', name: site.founder.name, jobTitle: site.founder.role },
};
const structured = [organization, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* A page kept out of search (the 404) names no canonical: its own address isn't a page at all. */}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f2efe8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Every page uses all four, so all four are asked for at once: a font found only once the page is
        laid out arrives after the first paint, and the whole page is laid out again when it swaps in.
        Chrome notes an unused preload when a font came from its own memory instead. */}
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plex400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plex500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plex600} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ph('domain') && <meta name="nk-placeholder" content="Canonical domain not confirmed" data-ph={ph('domain')} />}

    {/* Every < escaped, so no text in the data can ever close this script tag early. */}
    <script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, '\\u003c')} />

    <!-- Runs before first paint: the theme (light unless the visitor chose dark) and reduced motion. -->
    <script is:inline>
      (function () {
        var r = document.documentElement;
        r.classList.add('js');
        // Content waits hidden for the site's script to reveal it. If that script never ran by the
        // time the page has loaded (it failed to download, or the browser is too old for it), show
        // the page as it reads without JavaScript instead of leaving it blank.
        addEventListener('load', function () {
          if (!r.hasAttribute('data-ready')) r.classList.remove('js');
        });
        try {
          if (localStorage.getItem('nk-theme') === 'dark') r.dataset.theme = 'dark';
        } catch (e) {}
        if (r.dataset.theme === 'dark') {
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', '#0f0f0e');
        }
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) r.classList.add('calm');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BookingForm mode="dialog" />
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch between light and dark mode">
      <Icon name="sun" class="icon-sun" size={18} />
      <Icon name="moon" class="icon-moon" size={18} />
    </button>
    <div class="ruler" data-ruler aria-hidden="true">
      <span class="ruler__track"><span class="ruler__fill"></span></span>
      <span class="ruler__read" data-ruler-read>000</span>
    </div>
    {/* Netlify adds a "Powered by Netlify" badge script to every page it serves (/.netlify/scripts/hud).
        It builds the badge in a frame whose inline script the Content-Security-Policy blocks, which
        logs an error on every page. The script stands down when a frame by this name is already on
        the page, so this empty one keeps it from trying. Turning the badge off in Netlify's project
        settings, where the plan allows it, stops the script being sent at all. */}
    <template id="nl-badge-frame"></template>
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
