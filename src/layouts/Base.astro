---
import archivo from '../assets/fonts/archivo.woff2?url';
import archivoSigns from '../assets/fonts/archivo-signs.woff2?url';
import plex400 from '../assets/fonts/plex-mono-400.woff2?url';
import plex500 from '../assets/fonts/plex-mono-500.woff2?url';
import plex600 from '../assets/fonts/plex-mono-600.woff2?url';
import '../styles/fonts.css';
import '../styles/fallback.css';
import '../styles/global.css';
import BookingForm from '../components/BookingForm.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Nav from '../components/Nav.astro';
import { ph, site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path under /public for the social card. */
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** The page sets mono type in bold (figure numbers, step numbers, diagrams): most pages do. */
  boldMono?: boolean;
  /** The page has a split-flap board with signs on it (%, <, +), set in Archivo Signs. */
  signs?: boolean;
  /** The booking popup. Not on the book pages, whose booking buttons bring their own form into view. */
  bookingDialog?: boolean;
}

const {
  title = site.title,
  description = site.description,
  image = '/og.png',
  noindex = false,
  jsonLd,
  boldMono = true,
  signs = false,
  bookingDialog = true,
} = Astro.props;

// The web fonts this page sets text in. Once they're in the cache, the head script asks for them with
// the page, so they're there for its first paint (fonts.css, fonts.ts).
const fonts = [archivo, plex400, plex500, ...(boldMono ? [plex600] : []), ...(signs ? [archivoSigns] : [])];

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;

// An Organization, not a ProfessionalService: that's a kind of LocalBusiness, which Google expects to
// have a street address, and Neurokov works online. The logo is the 180px PNG: Google wants a raster
// image of at least 112px.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: new URL('/apple-touch-icon.png', site.url).href,
  description: site.description,
  areaServed: 'Worldwide',
  email: site.email,
  founder: { '@type': 'Person', name: site.founder.name, jobTitle: site.founder.role },
};
// On the home and about pages, as Google asks (the home page or one that describes the organisation);
// every other page carries only its own.
const aboutUs = ['/', '/about/'].includes(Astro.url.pathname);
const structured = [...(aboutUs ? [organization] : []), ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];

// The next page is ready before the click: a link to another page of the site is loaded and laid
// out (prerendered) as the pointer rests on it or a finger presses it, so it opens at once. The
// browser does it, no script to download: Chrome and Edge, while other browsers just follow the
// link. Not the booking buttons, which open the form where the visitor is.
const speculation = {
  prerender: [
    {
      where: { and: [{ href_matches: '/*' }, { not: { selector_matches: '[data-book]' } }] },
      eagerness: 'moderate',
    },
  ],
};
---

<!doctype html>
<html lang="en" data-fonts={fonts.join(' ')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* A page kept out of search (the 404) names no canonical: its own address isn't a page at all. */}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f2efe8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ph('domain') && <meta name="nk-placeholder" content="Canonical domain not confirmed" data-ph={ph('domain')} />}

    {/* Every < escaped, so no text in the data can ever close this script tag early. */}
    {structured.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, '\\u003c')} />}
    <script is:inline type="speculationrules" set:html={JSON.stringify(speculation)} />

    {/* Runs before first paint: the theme (light unless the visitor chose dark) and its button, and
        reduced motion. */}
    <script is:inline>
      (function () {
        var r = document.documentElement;
        r.classList.add('js', 'themes');
        // The web fonts once they're in the cache (fonts.ts puts them there once a page is up): until
        // then the page paints at once in the fonts the visitor has, sized to match (global.css: .cold).
        // Then they're asked for with the page, so they're there for its first paint. (Storage
        // blocked: asked for all the same, used if they come in time; fonts.css.)
        var cold = false;
        try {
          cold = localStorage.getItem('nk-fonts') !== '1';
        } catch (e) {}
        if (cold) r.classList.add('cold');
        else
          (r.getAttribute('data-fonts') || '').split(' ').forEach(function (href) {
            if (!href) return;
            var link = document.createElement('link');
            link.rel = 'preload';
            link.as = 'font';
            link.type = 'font/woff2';
            link.crossOrigin = '';
            link.href = href;
            document.head.appendChild(link);
          });
        // Content waits hidden for the site's script to reveal it. If that script hasn't claimed the
        // page by the time it has loaded (it failed to download, or the browser is too old for it),
        // show the page as it reads without JavaScript instead of leaving it blank.
        addEventListener('load', function () {
          if (!r.hasAttribute('data-ready')) r.classList.remove('js');
        });
        // The theme, and every button that switches it, working from the moment it's on the page.
        var meta = document.querySelector('meta[name="theme-color"]');
        var theme = function (dark) {
          if (dark) r.dataset.theme = 'dark';
          else delete r.dataset.theme;
          if (meta) meta.setAttribute('content', dark ? '#0f0f0e' : '#f2efe8');
        };
        // The moving parts (the tickers, living photos, the lead machine, the circuit and films that
        // play by themselves) stop for as long as the visitor wants, on every page, with the motion
        // button: anything moving for more than five seconds can be paused (WCAG 2.2.2). site.ts's
        // scripts listen for nk-motion.
        var labels = function () {
          var label = r.classList.contains('still') ? 'Play motion' : 'Pause motion';
          var all = document.querySelectorAll('[data-motion-label]');
          for (var i = 0; i < all.length; i++) all[i].textContent = label;
        };
        var still = function (on) {
          if (r.classList.contains('still') === on) return;
          r.classList.toggle('still', on);
          labels();
          document.dispatchEvent(new Event('nk-motion'));
        };
        document.addEventListener('DOMContentLoaded', labels);
        var stored = function () {
          try {
            theme(localStorage.getItem('nk-theme') === 'dark');
            still(localStorage.getItem('nk-motion') === 'still');
          } catch (e) {}
        };
        stored();
        // A page shown again from memory (Back), one made ahead of the click (prerendered) or one open
        // in another tab was set up before the theme or motion last changed: it takes them as they are now.
        addEventListener('pageshow', function (e) {
          if (e.persisted) stored();
        });
        document.addEventListener('prerenderingchange', stored);
        addEventListener('storage', function (e) {
          if (e.key === 'nk-theme' || e.key === 'nk-motion' || e.key === null) stored();
        });
        document.addEventListener('click', function (e) {
          if (!e.target.closest) return;
          if (e.target.closest('[data-theme-toggle]')) {
            var dark = r.dataset.theme !== 'dark';
            theme(dark);
            try {
              localStorage.setItem('nk-theme', dark ? 'dark' : 'light');
            } catch (err) {}
          } else if (e.target.closest('[data-motion-toggle]')) {
            var on = !r.classList.contains('still');
            still(on);
            try {
              localStorage.setItem('nk-motion', on ? 'still' : 'moving');
            } catch (err) {}
          }
        });
        // Back and Forward bring a page straight back: no wipe to wait through (nor taps lost in it).
        addEventListener('pagereveal', function (e) {
          var nav = window.navigation;
          if (e.viewTransition && nav && nav.activation && nav.activation.navigationType === 'traverse') e.viewTransition.skipTransition();
        });
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) r.classList.add('calm');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {bookingDialog && <BookingForm mode="dialog" />}
    <button class="theme-toggle theme-toggle--float" type="button" data-theme-toggle aria-label="Switch between light and dark mode">
      <Icon name="sun" class="icon-sun" size={18} />
      <Icon name="moon" class="icon-moon" size={18} />
    </button>
    <button class="motion-toggle motion-toggle--float" type="button" data-motion-toggle>
      <span class="sr-only" data-motion-label>Pause motion</span>
      <Icon name="pause" class="icon-pause" size={16} />
      <Icon name="play" class="icon-play" size={16} />
    </button>
    <div class="ruler" data-ruler aria-hidden="true">
      <span class="ruler__track"><span class="ruler__fill"></span></span>
      <span class="ruler__read" data-ruler-read>000</span>
    </div>
    {/* Netlify adds a "Powered by Netlify" badge script to every page it serves (/.netlify/scripts/hud).
        It builds the badge in a frame whose inline script the Content-Security-Policy blocks, which
        logs an error on every page. The script stands down when a frame by this name is already on
        the page, so this empty one keeps it from trying. Turning the badge off in Netlify's project
        settings, where the plan allows it, stops the script being sent at all. */}
    <template id="nl-badge-frame"></template>
    <script>
      import '../scripts/boot.ts';
    </script>
  </body>
</html>
