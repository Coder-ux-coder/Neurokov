---
/**
 * Quotes (testimonials.ts), each on a card under a big opening quote mark. A draft (only ever shown
 * while working on the site) says so on its card, and ?review outlines it like any placeholder.
 */
import { shownTestimonials } from '../data/testimonials';
---

<ul class="quotes">
  {
    shownTestimonials.map((t, i) => (
      <li class="card quote" data-reveal style={`--d: ${(i % 3) * 90}ms`} data-ph={t.draft ? 'testimonial' : undefined}>
        {t.draft && <span class="label quote__draft">Draft · waiting for the client’s OK · not on the live site</span>}
        <figure>
          <blockquote>
            <p>{t.quote}</p>
          </blockquote>
          <figcaption>
            <b>{t.name}</b>
            <span>{t.role}</span>
            {t.caseSlug && (
              <a class="text-link" href={`/case-studies/${t.caseSlug}/`}>
                Read the case →
              </a>
            )}
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>
