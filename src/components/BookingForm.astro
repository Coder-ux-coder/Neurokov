---
/**
 * The booking form, in two steps (booking.ts). Step 1 asks four questions: business name, niche,
 * monthly revenue and a few lines about the business. The answers are emailed to us the moment the
 * form is sent, booked or not (Web3Forms, through the access key below). Name and email are asked
 * once, by the booking page, which no other site can fill in for it. Step 2 takes the
 * form's place with the audit's booking page on Google Calendar, where the visitor picks a time.
 * `dialog` is the popup every booking button opens; `inline` sits on the book page.
 *
 * Without JavaScript the form still works: it posts the answers to Web3Forms itself, which
 * emails them to us and sends the visitor on to /book/pick-a-time/, the booking page on a page
 * of its own (Web3Forms' free plan only sends visitors on to pages on this site).
 */
import { bookingEmbedUrl, bookingUrl, ph, site, unconfirmed } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  mode: 'dialog' | 'inline';
}

const { mode } = Astro.props;
const id = (name: string) => `booking-${mode}-${name}`;
const revenues = ['Under $10k', '$10k–$50k', '$50k–$100k', '$100k–$500k', 'Over $500k', 'Prefer not to say'];
const Wrap = mode === 'dialog' ? 'dialog' : 'div';
const submitLabel = 'See available times';
// No key yet, no email: the form carries a placeholder marker instead, which stops the build, and
// without JavaScript it goes straight to the booking page.
const notifyKey = unconfirmed.has('web3forms') ? undefined : site.web3forms;
const pickATime = new URL('/book/pick-a-time/', site.url).href;
---

<Wrap
  class:list={[mode === 'dialog' ? 'booking-dialog' : 'booking-inline']}
  data-booking={mode}
  aria-labelledby={mode === 'dialog' ? id('title') : undefined}
>
  <form
    class="booking"
    action={notifyKey ? 'https://api.web3forms.com/submit' : bookingUrl}
    method={notifyKey ? 'post' : 'get'}
    data-ph={ph('web3forms')}
    aria-labelledby={mode === 'inline' ? id('title') : undefined}
  >
    {
      notifyKey && (
        <>
          <input type="hidden" name="access_key" value={notifyKey} />
          <input type="hidden" name="subject" value="New audit form" />
          <input type="hidden" name="from_name" value="Neurokov website" />
          <input type="hidden" name="redirect" value={pickATime} />
          {/* A trap for spam bots: never shown, so a person never ticks it, and Web3Forms drops any
              submission that has it ticked. */}
          <input class="booking__trap" type="checkbox" name="botcheck" tabindex="-1" aria-hidden="true" />
        </>
      )
    }
    <div class="booking__head">
      <span class="label label--signal">Step 1 of 2 · The basics</span>
      {
        mode === 'dialog' && (
          <button class="booking__x" type="button" data-booking-close aria-label="Close">
            <Icon name="x" size={16} />
          </button>
        )
      }
    </div>
    <h2 class="h3 booking__title" id={id('title')} tabindex="-1">Tell us about your business.</h2>
    <p class="booking__lead">
      Four quick questions, then you pick a time. Your answers let us do our homework before the call.
    </p>
    <div class="booking__fields">
      <div class="field field--wide">
        <label for={id('business')}>Business name</label>
        <input id={id('business')} name="business" type="text" required maxlength="120" autocomplete="organization" />
      </div>
      <div class="field">
        <label for={id('niche')}>Niche</label>
        <input id={id('niche')} name="niche" type="text" required maxlength="120" placeholder="e.g. dental clinics" />
      </div>
      <div class="field">
        <label for={id('revenue')}>Monthly revenue</label>
        <span class="field__select">
          <select id={id('revenue')} name="revenue" required>
            <option value="" disabled selected>Pick a range</option>
            {revenues.map((r) => <option>{r}</option>)}
          </select>
        </span>
      </div>
      <div class="field field--wide">
        <label for={id('about')}>About the business</label>
        <textarea
          id={id('about')}
          name="about"
          required
          maxlength="1000"
          rows={mode === 'dialog' ? 3 : 4}
          placeholder="What you sell, who you sell to, and what eats your team’s week."></textarea>
      </div>
    </div>
    <div class="booking__foot">
      <button class="btn" type="submit">
        <span class="btn__label"><span>{submitLabel}</span><span aria-hidden="true">{submitLabel}</span></span>
        <span class="btn__dot" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          <svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
        </span>
      </button>
      <p class="cta__note booking__note">
        <Icon name="shield-check" size={16} /> Your answers reach us by email when you press the button.
      </p>
    </div>
  </form>
  {/* Step 2: the booking page, loaded once the answers are sent (booking.ts). */}
  <div class="booking-time" data-booking-time role="group" aria-labelledby={id('time')} tabindex="-1" hidden>
    <div class="booking__head">
      <span class="label label--signal">Step 2 of 2 · Pick a time</span>
      {
        mode === 'dialog' && (
          <button class="booking__x" type="button" data-booking-close aria-label="Close">
            <Icon name="x" size={16} />
          </button>
        )
      }
    </div>
    <h2 class="h3 booking__title" id={id('time')}>Pick a time that suits you.</h2>
    <div class="booking-time__frame" data-booking-frame data-src={bookingEmbedUrl} data-ph={ph('booking')}></div>
    <p class="cta__note booking__note">
      <Icon name="calendar-check" size={16} />
      <a class="text-link" href={bookingUrl} target="_blank" rel="noopener">Open the booking page in a new tab</a>
    </p>
  </div>
</Wrap>
