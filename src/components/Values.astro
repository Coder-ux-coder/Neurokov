---
import Icon from './Icon.astro';
import type { IconName } from './icons';

const values: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'target',
    title: 'Paid for clients, not effort',
    text: 'We don’t sell hours, reports or “brand awareness”. We sell booked calls and new clients, and we measure ourselves the same way.',
  },
  {
    icon: 'timer',
    title: 'Results from day one',
    text: 'The slow setup happens before launch, so day one is a real day: leads answered in under a minute, conversations started, calls booked.',
  },
  {
    icon: 'key-round',
    title: 'Your brand, protected',
    text: 'Separate sending domains, messages you approve and nothing that reads like spam. Your main domain and your reputation are never on the line.',
  },
  {
    icon: 'shield-check',
    title: 'Results, or you don’t pay',
    text: 'One plan and one fixed price, agreed before we start. If we don’t deliver what the plan says, you don’t pay. The risk sits with us.',
  },
];
const total = String(values.length).padStart(2, '0');
---

<div class="grid-4 specs">
  {
    values.map((v, i) => (
      <article class="spec" data-reveal style={`--d: ${i * 90}ms`}>
        <div class="spec__top">
          <span class="spec__n">
            {String(i + 1).padStart(2, '0')} / {total}
          </span>
          <span class="card__icon">
            <Icon name={v.icon} />
          </span>
        </div>
        <h3 class="h3">{v.title}</h3>
        <p>{v.text}</p>
      </article>
    ))
  }
</div>
