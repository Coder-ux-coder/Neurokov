---
/**
 * The homepage reel: one story clip per case study (Clip.astro), with its
 * headline number on a split-flap readout under the film that flips as the
 * stories change (slides.ts).
 */
import { cases } from '../data/cases';
import Clip from './Clip.astro';
import Flap from './Flap.astro';
import Icon from './Icon.astro';

const order = ['outbound-engine', 'speed-to-lead', 'psychology-platform'];
const slides = order.map((slug) => {
  const c = cases.find((x) => x.slug === slug)!;
  return { ...c, n: String(cases.indexOf(c) + 1).padStart(2, '0'), stat: c.stats[0] };
});
const pad = Math.max(...slides.map((s) => s.stat.value.length));
const first = slides[0];
const sizes = '(max-width: 960px) 100vw, 760px';
---

<div class="slides" data-slides role="region" aria-roledescription="carousel" aria-label="Case studies, told as stories">
  <div class="slides__viewport">
    {
      slides.map((s, i) => (
        <div
          class:list={['slide', i === 0 && 'is-active']}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${slides.length}: ${s.title}`}
          aria-hidden={i === 0 ? undefined : 'true'}
          data-stat={s.stat.value}
          data-label={s.stat.label}
          data-title={s.title}
          data-n={s.n}
          data-href={`/case-studies/${s.slug}/`}
        >
          <Clip name={s.clip} mode="manual" loop={false} eager={i === 0} sizes={sizes} />
        </div>
      ))
    }
  </div>
  <div class="slides__hud" data-dark>
    <div class="slides__readout">
      <Flap value={first.stat.value} pad={pad} />
      <span class="slides__statlabel" data-slide-label>{first.stat.label}</span>
    </div>
    <!-- What a screen reader hears when the visitor changes story (the label above scrambles on its way in). -->
    <p class="sr-only" aria-live="polite" data-slide-say></p>
    <div class="slides__controls">
      <button class="slides__btn" type="button" data-slide-prev aria-label="Previous story">
        <Icon name="arrow-left" size={16} />
      </button>
      <button class="slides__btn" type="button" data-slide-pause aria-label="Pause the story" aria-pressed="false">
        <svg class="i-pause" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 3h3v10H4zM9 3h3v10H9z" fill="currentColor"></path></svg>
        <svg class="i-play" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5 3l8 5-8 5z" fill="currentColor"></path></svg>
      </button>
      <button class="slides__btn" type="button" data-slide-next aria-label="Next story">
        <Icon name="arrow-right" size={16} />
      </button>
    </div>
  </div>
  <ol class="slides__progress" style={`--n: ${slides.length}`}>
    {
      slides.map((s, i) => (
        <li>
          <button type="button" data-slide-to={i} aria-label={`Show case ${s.n}: ${s.title}`}>
            <span />
          </button>
        </li>
      ))
    }
  </ol>
  <div class="slides__caption">
    <span class="label">
      <b>Fig. 01</b>&nbsp;Case <span data-slide-n>{first.n}</span><span class="slides__name">&nbsp;· <span data-slide-title>{first.title}</span></span>
    </span>
    <a class="label slides__read" href={`/case-studies/${first.slug}/`} data-slide-link>
      Read the case <Icon name="arrow-up-right" size={14} />
    </a>
  </div>
</div>
