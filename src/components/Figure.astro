---
/** A numbered figure with a caption rule underneath, like a plate in a report. */
interface Props {
  n: string;
  caption: string;
  class?: string;
}

const { n, caption, class: cls } = Astro.props;
const num = n.padStart(2, '0'); // Fig. 01, however the page counts
---

<figure class:list={['fig', cls]}>
  <slot />
  <figcaption class="fig__cap">
    <b>Fig. {num}</b>
    <span>{caption}</span>
  </figcaption>
</figure>
