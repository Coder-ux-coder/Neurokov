---
/** A figure with a caption rule underneath, like a plate in a report. (Numbered "Fig. 01" until
 *  2026-10-10: the owner dropped the numbering labels.) */
interface Props {
  caption: string;
  class?: string;
}

const { caption, class: cls } = Astro.props;
---

<figure class:list={['fig', cls]}>
  <slot />
  <figcaption class="fig__cap">{caption}</figcaption>
</figure>
