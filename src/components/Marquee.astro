---
import { marqueeTools, toolMark } from '../data/tools';

interface Props {
  label?: string;
}

const { label = 'We work with the tools you already use' } = Astro.props;
const items = marqueeTools.map((name) => ({ name, path: toolMark(name) }));
---

<section class="marquee" aria-label={label}>
  <p class="marquee__label">{label}</p>
  <div class="marquee__viewport">
    <div class="marquee__track">
      {
        [0, 1].map((copy) => (
          <ul class="marquee__list" aria-hidden={copy === 1 ? 'true' : undefined}>
            {items.map((t) => (
              <li class="marquee__item">
                {t.path && (
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path d={t.path} />
                  </svg>
                )}
                {t.name}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>
