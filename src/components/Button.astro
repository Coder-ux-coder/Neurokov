---
/**
 * The pill button. With no href it books a call: every such button on the site
 * opens the booking form (BookingForm.astro, booking.ts), then the free audit's
 * booking page. On the book page it brings that page's own form into view.
 * Without JavaScript it's a link to the book page.
 */
import { cta, ph } from '../data/site';

interface Props {
  label?: string;
  href?: string;
  size?: 'sm' | 'md' | 'lg';
  variant?: 'solid' | 'ghost';
  class?: string;
}

const { label = cta.label, href, size = 'md', variant = 'solid', class: cls } = Astro.props;
const books = !href;
// On the booking page of its own (step 2 without JavaScript), the visitor has answered already:
// the buttons point at the booking page there, not back to the questions.
const bookHref = Astro.url.pathname.startsWith('/book/pick-a-time') ? '#pick' : '/book/';

const bookingAttrs = books ? { href: bookHref, 'data-book': '', 'data-ph': ph('booking') } : { href };
---

<a class:list={['btn', size !== 'md' && `btn--${size}`, variant === 'ghost' && 'btn--ghost', cls]} {...bookingAttrs}>
  <span class="btn__label"><span>{label}</span><span aria-hidden="true">{label}</span></span>
  <span class="btn__dot" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
  </span>
</a>
