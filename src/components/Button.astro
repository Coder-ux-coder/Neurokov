---
/**
 * The pill button. With no href it books a call: every such button on the site
 * opens the booking form (BookingForm.astro, booking.ts), whose answers go with
 * the booking to the same Cal.com event. On the book page it brings that page's
 * own form into view. Without JavaScript it's a link to the book page.
 */
import { cta, ph, site } from '../data/site';

interface Props {
  label?: string;
  href?: string;
  size?: 'sm' | 'md' | 'lg';
  variant?: 'solid' | 'ghost';
  class?: string;
}

const { label = cta.label, href, size = 'md', variant = 'solid', class: cls } = Astro.props;
const books = !href;

// Not Cal's own data-cal-link hook: the form comes first, and booking.ts opens
// Cal.com's popup itself once it has the answers.
const bookingAttrs = books ? { href: '/book/', 'data-book': site.cal.link, 'data-ph': ph('cal') } : { href };
---

<a class:list={['btn', size !== 'md' && `btn--${size}`, variant === 'ghost' && 'btn--ghost', cls]} {...bookingAttrs}>
  <span class="btn__label"><span>{label}</span><span aria-hidden="true">{label}</span></span>
  <span class="btn__dot" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
  </span>
</a>
