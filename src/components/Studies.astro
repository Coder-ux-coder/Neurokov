---
/**
 * The case studies as a ruled index. On a desktop the row's story clip plays in
 * a frame that follows the cursor down the list (studies.ts); on touch screens
 * each row shows the clip's poster inline.
 */
import { cases } from '../data/cases';
import Clip from './Clip.astro';
import Icon from './Icon.astro';

// Same sizes as the hero reel, so the browser reuses the posters it already has.
const sizes = '(max-width: 960px) 100vw, 760px';
---

<div class="studies" data-studies>
  <ol class="rows">
    {
      cases.map((c, i) => (
        <li>
          <a class="row" href={`/case-studies/${c.slug}/`} data-reveal style={`--d: ${i * 70}ms`} data-i={i}>
            <span class="row__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="row__main">
              <span class="row__name">{c.title}</span>
              <span class="row__meta">{c.client}</span>
            </span>
            <span class="row__stat">
              <b>{c.stats[0].value}</b>
              <span>{c.stats[0].label}</span>
            </span>
            <span class="row__go" aria-hidden="true">
              <Icon name="arrow-up-right" size={20} />
            </span>
            <div class="row__thumb" aria-hidden="true">
              <Clip name={c.clip} mode="manual" sizes={sizes} decorative />
            </div>
          </a>
        </li>
      ))
    }
  </ol>
  <div class="studies__preview" aria-hidden="true">
    <div class="studies__frame">
      {cases.map((c) => <Clip name={c.clip} mode="manual" sizes={sizes} decorative />)}
      <span class="studies__label label" data-studies-label></span>
    </div>
  </div>
</div>
