---
/**
 * The headline numbers on a split-flap board, standing still (they flipped in as the board scrolled
 * into view until 2026-10-10, when the owner dropped the counting numbers). Where a case states what
 * it was, before -> after: the old figure on small, dim tiles, an arrow, the number. Under each, what
 * it covers (stats.ts, `note`).
 */
import { formatStat, heroStats, statsArePlaceholders, type Stat } from '../data/stats';
import Flap from './Flap.astro';
import Icon from './Icon.astro';

interface Props {
  stats?: Stat[];
}

const { stats = heroStats } = Astro.props;
---

<div
  class="board"
  data-reveal
  data-dark
  style={`--cols: ${stats.length}`}
  data-ph={statsArePlaceholders ? 'stats' : undefined}
>
  {
    stats.map((s) => (
      <div class="board__cell">
        {s.before ? (
          <div class="board__value">
            <Flap value={s.before} class="flap--was" />
            <span class="board__to">
              <Icon name="arrow-right" size={24} strokeWidth={2.5} />
              <span class="sr-only">to</span>
            </span>
            <Flap value={formatStat(s)} />
          </div>
        ) : (
          <Flap value={formatStat(s)} />
        )}
        <span class="board__label">{s.label}</span>
        {s.note && <span class="board__note">{s.note}</span>}
      </div>
    ))
  }
</div>
