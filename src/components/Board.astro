---
/** The headline numbers on a split-flap board. They flip in when the board scrolls into view. */
import { formatStat, heroStats, statsArePlaceholders, type Stat } from '../data/stats';
import Flap from './Flap.astro';

interface Props {
  stats?: Stat[];
}

const { stats = heroStats } = Astro.props;
---

<div
  class="board"
  data-reveal
  data-dark
  style={`--cols: ${stats.length}`}
  data-ph={statsArePlaceholders ? 'stats' : undefined}
>
  {
    stats.map((s) => (
      <div class="board__cell">
        <Flap value={formatStat(s)} />
        <span class="board__label">{s.label}</span>
      </div>
    ))
  }
</div>
