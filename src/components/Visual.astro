---
/**
 * An image slot. If src/assets/images/<name>.* exists it renders as a
 * responsive AVIF/WebP picture; until then it renders placeholder art (marked
 * data-ph, so it can't ship by accident). With `dither`, the photo develops
 * out of a halftone pattern the first time it scrolls into view (dither.ts).
 * With `live`, and a src/assets/video/<name>.mp4 made by design/composite/video.py,
 * the screens in the photo come alive: the loop plays over the still, which is
 * its first frame (live.ts).
 */
import { statSync } from 'node:fs';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  name: string;
  alt: string;
  icon?: IconName;
  ratio?: string;
  sizes?: string;
  eager?: boolean;
  dither?: boolean;
  live?: boolean;
  class?: string;
}

const {
  name,
  alt,
  icon = 'sparkles',
  ratio,
  sizes = '(max-width: 900px) 100vw, 50vw',
  eager = false,
  dither = false,
  live = false,
  class: cls,
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
let img = Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.[^.]+$/, '') === name)?.[1]
  .default;
// The dev server's /_image URLs stay the same when a photo is replaced at the same size, and browsers cache them for
// a year, so they keep showing the old photo. Versioning the URL by the file's mtime stops that. Builds hash the file.
if (img && import.meta.env.DEV) {
  const { fsPath } = img as ImageMetadata & { fsPath: string };
  const v = Math.round(statSync(fsPath).mtimeMs).toString(36);
  img = { ...img, src: `${img.src}${img.src.includes('?') ? '&' : '?'}v=${v}` };
}
const videos = import.meta.glob<string>('/src/assets/video/*.mp4', { eager: true, query: '?url', import: 'default' });
const video = img && live ? Object.entries(videos).find(([path]) => path.endsWith(`/${name}.mp4`))?.[1] : undefined;
const widths = img ? [480, 768, 1080, 1440, 1920].filter((w) => w <= img.width) : [];
if (img && !widths.includes(img.width) && img.width < 1920) widths.push(img.width);
---

<div class:list={['media', cls]} style={ratio ? `--ratio: ${ratio}` : undefined} data-dither={img && dither ? '' : undefined}>
  {
    img ? (
      <Picture
        src={img}
        alt={alt}
        formats={['avif', 'webp']}
        widths={widths}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    ) : (
      <div class="art" role="img" aria-label={alt} data-ph={`image:${name}`}>
        <span class="art__icon">
          <Icon name={icon} size={28} />
        </span>
      </div>
    )
  }
  {video && <video class="media__video" src={video} muted loop playsinline preload="none" aria-hidden="true" data-live />}
  <slot />
</div>

<style>
  .media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
