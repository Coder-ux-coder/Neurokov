---
/** The credentials under the hero, set like the lines of a system check. */
import { toolMark } from '../data/tools';
import Icon from './Icon.astro';
---

<div class="creds-block">
  <span class="label">Credentials</span>
  <ul class="creds" aria-label="Credentials">
    <li>
      <span class="creds__k">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d={toolMark('n8n')}></path></svg>
        n8n certified
      </span>
      <span class="creds__v"><Icon name="check" size={15} /><span class="sr-only">Yes</span></span>
    </li>
    <li>
      <span class="creds__k">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d={toolMark('Claude')}></path></svg>
        Claude experts
      </span>
      <span class="creds__v"><Icon name="check" size={15} /><span class="sr-only">Yes</span></span>
    </li>
    <li>
      <span class="creds__k"><Icon name="workflow" size={15} /> Automations shipped</span>
      <span class="creds__v">150+</span>
    </li>
    <li>
      <span class="creds__k"><Icon name="shield-check" size={15} /> Guarantee</span>
      <span class="creds__v">It works or you don’t pay</span>
    </li>
  </ul>
</div>
