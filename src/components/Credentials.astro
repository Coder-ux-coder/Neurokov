---
/** The track record under the hero, set like the lines of a system check. Case 02's numbers. */
import Icon from './Icon.astro';
---

<div class="creds-block">
  <span class="label">Track record</span>
  <ul class="creds" aria-label="Track record">
    <li>
      <span class="creds__k"><Icon name="mail" size={15} /> Inbox placement</span>
      <span class="creds__v">90%+</span>
    </li>
    <li>
      <span class="creds__k"><Icon name="users" size={15} /> Sales hires you need</span>
      <span class="creds__v">0</span>
    </li>
    <li>
      <span class="creds__k"><Icon name="calendar-check" size={15} /> Growth audit</span>
      <span class="creds__v">Free</span>
    </li>
    <li>
      <span class="creds__k"><Icon name="shield-check" size={15} /> Guarantee</span>
      <span class="creds__v">Results or you don’t pay</span>
    </li>
  </ul>
</div>
