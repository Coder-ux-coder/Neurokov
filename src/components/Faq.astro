---
import type { Faq } from '../data/faqs';
import { ph } from '../data/site';

interface Props {
  items: Faq[];
  /** Details sharing a name open one at a time. */
  group?: string;
}

const { items, group = 'faq' } = Astro.props;
---

<div class="faq" data-reveal>
  {
    items.map((f) => (
      <details name={group} data-ph={f.ph && ph(f.ph)}>
        <summary>
          {f.q}
          <span class="faq__plus" aria-hidden="true" />
        </summary>
        <div class="faq__answer">
          <p>{f.a}</p>
        </div>
      </details>
    ))
  }
</div>
