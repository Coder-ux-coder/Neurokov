---
/**
 * The Neurokov mark: an N whose diagonal is the signal orange, the one path
 * through the system. The wordmark is set in wide Archivo capitals.
 */
interface Props {
  variant?: 'full' | 'mark';
  class?: string;
}

const { variant = 'full', class: cls } = Astro.props;
---

<span class:list={['logo', cls]}>
  <svg class="logo__mark" viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
    <path d="M5 5h5v22H5zM22 5h5v22h-5z" fill="currentColor"></path>
    <path d="M5 5h5l17 22h-5z" fill="var(--accent)"></path>
  </svg>
  {variant === 'full' && <span class="logo__word">Neurokov</span>}
</span>
