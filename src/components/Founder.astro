---
/**
 * The founder, filed like a personnel record. No photo (the user's call):
 * credentials on the left, a third-person bio on the right, the way LeftClick
 * writes its leadership bios. Since 2026-10-05 Neurokov sells new clients, so the
 * record leads with growth; every number is from the confirmed case studies. With
 * `film` (its figure number on the page), the story of the platform he co-founded
 * (case 01) plays above the record.
 */
import { clips } from '../data/clips';
import { site } from '../data/site';
import Clip from './Clip.astro';
import Figure from './Figure.astro';
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  film?: string;
}

const { film } = Astro.props;

const creds: { text: string; icon: IconName }[] = [
  { text: `${site.founder.role}, ${site.name}`, icon: 'badge-check' },
  { text: 'Co-founder, online psychology platform', icon: 'heart-pulse' },
  { text: 'Grew it 100%+ in a single month', icon: 'trending-up' },
  { text: 'Results, or you don’t pay', icon: 'shield-check' },
];
---

{
  film && (
    <div class="founder-film" data-reveal>
      <Figure n={film} class="fig--film" caption={`${clips.psychology.title}: the platform he co-founded. Illustrated, with real numbers from case 01.`}>
        <div class="marks">
          <Clip name="psychology" sizes="(max-width: 1320px) 100vw, 1320px" />
        </div>
      </Figure>
    </div>
  )
}
<div class="founder" data-reveal>
  <span class="founder__file" aria-hidden="true">File 001 · Founder</span>
  <div class="founder__id">
    <span class="label label--signal">Founder</span>
    <h3 class="founder__name">{site.founder.name}</h3>
    <p class="founder__role">{site.founder.role}, {site.name}</p>
    <ul class="founder__creds">
      {
        creds.map((c) => (
          <li>
            <span class="founder__cred-icon">
              <Icon name={c.icon} size={17} />
            </span>
            {c.text}
          </li>
        ))
      }
    </ul>
  </div>
  <div class="founder__bio">
    <p>
      Mohid co-founded an online psychology platform and grew it by over 100% in a single month, by bringing new clients
      in and making sure every enquiry turned into a booked session.
    </p>
    <p>
      At {site.name} he does the same for other businesses: finds the clients, answers every lead in seconds and puts the
      calls on the calendar.
    </p>
    <p>
      {site.name} has booked a growth agency 46 qualified calls in its first 30 days and cut a consulting firm’s first
      reply from 19 hours to under 60 seconds. Every client gets the same promise: results, or you don’t pay.
    </p>
    <dl class="founder__stats">
      <div><dt>Growth in one month</dt><dd>100%+</dd></div>
      <div><dt>Calls in 30 days</dt><dd>46</dd></div>
      <div><dt>First reply</dt><dd>&lt;60s</dd></div>
    </dl>
  </div>
</div>
