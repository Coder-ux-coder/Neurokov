---
/**
 * The founder, filed like a personnel record. No photo (the user's call):
 * credentials on the left, a third-person bio on the right, the way LeftClick
 * writes its leadership bios. With `film`, his
 * story film plays above the record. Neurokov itself is new (2026); Mohid has
 * been doing this since 2023, so the record says when he started, not when the
 * company did. Every number is from the confirmed case studies or his own account, and each can be
 * checked: since 2026-10-10 the record claims no rank (it said "top 1%").
 */
import { clips } from '../data/clips';
import { site } from '../data/site';
import Clip from './Clip.astro';
import Figure from './Figure.astro';
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  film?: boolean;
}

const { film } = Astro.props;

const creds: { text: string; icon: IconName }[] = [
  { text: `${site.founder.role}, ${site.name}`, icon: 'briefcase-business' },
  { text: '150+ automations shipped', icon: 'workflow' },
  { text: 'Co-founder, online psychology platform', icon: 'heart-pulse' },
  { text: 'Grew it 100%+ in a single month', icon: 'trending-up' },
  { text: 'Doing this since 2023', icon: 'history' },
];
---

{
  film && (
    <div class="founder-film" data-reveal>
      <Figure class="fig--film" caption={`${clips.founder.title}. Illustrated, in his own words.`}>
        <div class="marks">
          <Clip name="founder" sizes="(max-width: 1320px) 100vw, 1320px" />
        </div>
      </Figure>
    </div>
  )
}
<div class="founder" data-reveal>
  <div class="founder__id">
    <span class="label label--signal">Founder</span>
    <h3 class="founder__name">{site.founder.name}</h3>
    <p class="founder__role">{site.founder.role}, {site.name}</p>
    <ul class="founder__creds">
      {
        creds.map((c) => (
          <li>
            <span class="founder__cred-icon">
              <Icon name={c.icon} size={17} />
            </span>
            {c.text}
          </li>
        ))
      }
    </ul>
  </div>
  <div class="founder__bio">
    <p>
      Mohid has been growing businesses since 2023. He has shipped 150+ automations, handing 50K+ hours back to the
      businesses he built them for, and he’s n8n certified. He shares what works with the sales and lead generation
      communities he’s part of.
    </p>
    <p>
      He co-founded an online psychology platform and grew it by over 100% in a single month, by bringing new clients
      in and making sure every enquiry turned into a booked session.
    </p>
    <p>
      {site.name} is new. The experience behind it isn’t. Every client gets the same promise: results, or you don’t pay.
    </p>
    <dl class="founder__stats">
      <div><dt>Doing this since</dt><dd>2023</dd></div>
      <div><dt>Growth in one month</dt><dd>100%+</dd></div>
      <div><dt>Automations shipped</dt><dd>150+</dd></div>
    </dl>
  </div>
</div>
