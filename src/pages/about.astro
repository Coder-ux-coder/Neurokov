---
import Button from '../components/Button.astro';
import Clip from '../components/Clip.astro';
import Cta from '../components/Cta.astro';
import Figure from '../components/Figure.astro';
import Founder from '../components/Founder.astro';
import Guarantee from '../components/Guarantee.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import Values from '../components/Values.astro';
import { clips } from '../data/clips';
import { industries } from '../data/industries';
import { site } from '../data/site';
import Base from '../layouts/Base.astro';

const options = [
  {
    title: 'Hiring a sales rep',
    points: [
      'Months to find, hire and train the right person',
      'A full salary before a single call is booked',
      'Good reps are hard to find and harder to keep',
      'When they leave, the pipeline leaves with them',
    ],
  },
  {
    title: 'Freelancers and DIY',
    points: [
      'Cheap, until a bought list burns your domain',
      'You end up writing the messages and chasing the replies',
      'Nobody accountable for whether calls get booked',
      'Gone when the results dry up',
    ],
  },
  {
    title: site.name,
    us: true,
    points: [
      '17 qualified calls in 30 days from cold outbound',
      'Every lead answered in under 60 seconds',
      'One fixed price. If we don’t deliver, you don’t pay',
      'Your lists, domains and accounts stay yours',
    ],
  },
];

const wontDo = ['Websites, apps or branding', 'Running your ads or social accounts', 'Billing by the hour', 'Reports full of vanity metrics'];
---

<Base
  title={`About | ${site.name}`}
  description="Neurokov is a lead generation agency for B2B service businesses. We find your buyers, answer every lead in under a minute and book the calls. Results, or you don’t pay."
>
  <section class="page-hero" data-hold>
    <div class="gridlines" aria-hidden="true"></div>
    <div class="container">
      <div class="runhead" data-reveal>
        <span class="label label--signal"><span data-decode>About {site.name}</span></span>
        <span class="runhead__line draw" aria-hidden="true"></span>
        <span class="label runhead__meta">For B2B service businesses</span>
      </div>
      <div class="split">
        <div class="split__copy">
          <h1 class="h1" data-reveal data-split>We get good businesses the clients they deserve.</h1>
          <p class="lead" data-reveal style="--d: 220ms">
            {site.name} is a lead generation agency for B2B service businesses. We find your buyers, answer every lead in
            under a minute and put the calls on your calendar. One simple guarantee: results, or you don’t pay.
          </p>
          <div data-reveal style="--d: 320ms"><Button size="lg" label="See where your next clients are" /></div>
        </div>
        <div class="split__media" data-reveal style="--d: 160ms">
          <Figure caption={`${clips['outbound-engine'].title}. Illustrated, with real numbers from case 01.`}>
            <div class="marks">
              <Clip name="outbound-engine" sizes="(max-width: 900px) 100vw, 620px" eager />
            </div>
          </Figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        label="Who’s behind it"
        title="Growth we delivered for ourselves first."
        lead="Before we grew anyone else’s business, our founder grew his own."
      />
      <Founder film />
    </div>
  </section>

  <section class="section section--deep">
    <div class="container split split--top">
      <div class="split__copy">
        <SectionHead label="The problem" title="Great at the work. Short on clients." />
      </div>
      <div class="prose prose--lead" data-reveal style="--d: 120ms">
        <p>
          Every service business we talk to tells a version of the same story. The work is excellent, the clients who find
          them love them, and the pipeline still runs on referrals and luck.
        </p>
        <p>
          Some months are packed. Others are silent. New leads wait hours for a reply and book with someone faster. Old
          leads never hear from anyone again.
        </p>
        <p>Working harder on the delivery doesn’t fix it. The clients have to come from somewhere.</p>
        <p>
          That’s the part we fix. We bring the clients in, so you can get back to doing the work you’re great at.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        label="The options"
        title="Why the usual options fall short."
        lead="When the pipeline runs dry, most businesses hire a rep, try a freelancer or do the outreach themselves. Here’s how that usually goes."
      />
      <div class="grid-3 compare">
        {
          options.map((o, i) => (
            <article class:list={['card', o.us && 'card--us']} data-reveal style={`--d: ${i * 90}ms`}>
              <span class="label">{o.us ? 'Recommended' : `Option ${String(i + 1).padStart(2, '0')}`}</span>
              <h3 class="h3">{o.title}</h3>
              <ul>
                {o.points.map((p) => (
                  <li>
                    <Icon name={o.us ? 'check' : 'x'} size={18} />
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--ink" data-dark>
    <div class="container">
      <SectionHead label="How we work" title="How we work." />
      <Values />
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <article class="card fit-card" data-reveal>
        <span class="label label--signal">Fit</span>
        <h2 class="h3">Who we work with.</h2>
        <p>
          B2B service businesses that sell expertise: agencies, consulting firms, IT companies and healthcare businesses. If
          you’re brilliant at the work and want more clients to do it for, we built {site.name} for you.
        </p>
        <ul class="tags">
          {industries.map((ind) => <li class="tag">{ind.title}</li>)}
        </ul>
      </article>
      <article class="card fit-card" data-reveal style="--d: 90ms">
        <span class="label label--signal">Out of scope</span>
        <h2 class="h3">What we don’t do.</h2>
        <p>We bring you clients. That’s it, and it’s why we can guarantee it. So you won’t get these from us:</p>
        <ul class="checks checks--x">
          {
            wontDo.map((w) => (
              <li>
                <Icon name="x" size={18} />
                {w}
              </li>
            ))
          }
        </ul>
      </article>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container"><Guarantee /></div>
  </section>

  <Cta />
</Base>
