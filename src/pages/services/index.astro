---
import Board from '../../components/Board.astro';
import Cta from '../../components/Cta.astro';
import Guarantee from '../../components/Guarantee.astro';
import Icon from '../../components/Icon.astro';
import Machine from '../../components/Machine.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import ServiceRows from '../../components/ServiceRows.astro';
import type { IconName } from '../../components/icons';
import { industries } from '../../data/industries';
import { priceBands, priceNote } from '../../data/pricing';
import { services } from '../../data/services';
import { ph, site } from '../../data/site';
import Base from '../../layouts/Base.astro';

const promises: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'calendar-check',
    title: 'Booked calls, not reports',
    text: 'We’re judged on calls on your calendar and new clients, not opens, impressions or activity.',
  },
  {
    icon: 'shield-check',
    title: 'Results, or you don’t pay',
    text: 'We agree in writing what we’ll deliver. If we don’t deliver it, you don’t pay.',
  },
  {
    icon: 'receipt',
    title: 'One fixed price',
    text: 'Agreed before any work starts. No hourly billing, no scope creep and no surprise invoices.',
  },
  {
    icon: 'key-round',
    title: 'Yours to keep',
    text: 'Your contact lists, messages, domains and accounts are yours. If we part ways, you keep all of it.',
  },
  {
    icon: 'mail',
    title: 'Your reputation, protected',
    text: 'Separate sending domains and messages you approve, so your main domain and your name are never on the line.',
  },
  {
    icon: 'trending-up',
    title: 'Numbers you can see',
    text: 'A simple report on replies, booked calls and new clients, so you always know exactly what you’re getting.',
  },
];
const n2 = (i: number, of: number) => `${String(i + 1).padStart(2, '0')} / ${String(of).padStart(2, '0')}`;
// The sections' numbers: four, and a fifth while there are price bands to show (pricing.ts).
const sections = priceBands.length ? 5 : 4;
const at = (n: number) => n2(n - 1, sections);
---

<Base
  title={`Services | ${site.name}`}
  description="Outbound lead generation, inbound lead conversion and lead reactivation for B2B service businesses. Booked calls and new clients. Results, or you don’t pay."
  signs
>
  <PageHero
    label="Services"
    meta={`${String(services.length).padStart(2, '0')} services`}
    title="New clients, from every direction."
    lead="New buyers reached by cold email and cold calling, every lead you already get answered in under a minute, and old leads turned back into deals."
    cta="Find your fastest route to clients"
    promise="And the audit is 100% free."
  />

  <section class="section">
    <div class="container">
      {/* On the first screen from a phone up, with nothing between it and the opening any more. */}
      <SectionHead
        hold
        label="What we do"
        index={at(1)}
        title="Three ways we bring you clients."
        lead="Each one starts with a free audit and is judged on one thing: booked calls that turn into new clients."
      />
      <ServiceRows />
    </div>
  </section>

  <section class="section section--tight" style="padding-top: 0">
    <div class="container"><Board /></div>
  </section>

  <section class="section section--deep">
    <div class="container">
      <SectionHead
        label="How it works"
        index={at(2)}
        title="Every lead answered in under 60 seconds."
        lead="Here’s how we handle the leads you already get, as a working model. Leads land from every channel, get checked against your ideal client, answered and booked while your team gets on with the day."
      />
      <div data-reveal><Machine /></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        label="Every client"
        index={at(3)}
        title="What every client gets."
        lead="Whichever service you start with, you get the same six things."
      />
      <div class="grid-3 specs">
        {
          promises.map((p, i) => (
            <article class="spec" data-reveal style={`--d: ${(i % 3) * 90}ms`}>
              <div class="spec__top">
                <span class="spec__n">{n2(i, promises.length)}</span>
                <span class="card__icon">
                  <Icon name={p.icon} />
                </span>
              </div>
              <h3 class="h3">{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--deep">
    <div class="container">
      <SectionHead
        label="Industries"
        index={at(4)}
        title="Built for service businesses."
        lead="Different industries, same problem: great work, and not enough clients to do it for. Here’s what we deliver where you work."
      />
      <ol class="ledger">
        {
          industries.map((ind, i) => (
            <li class="ledger__row" data-reveal style={`--d: ${(i % 3) * 60}ms`}>
              <span class="ledger__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="ledger__icon">
                <Icon name={ind.icon} />
              </span>
              <div class="ledger__main">
                <h3 class="h3">{ind.title}</h3>
                <p>{ind.text}</p>
              </div>
              <ul class="tags">
                {ind.tags.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    priceBands.length > 0 && (
      <section class="section">
        <div class="container">
          <SectionHead
            label="Pricing"
            index={at(5)}
            title="What it costs."
            lead="One fixed price for the setup and the first 60 days, agreed after the free audit. Here’s where it usually lands."
          />
          <div class="grid-3 specs" data-ph={ph('prices')}>
            {priceBands.map((p, i) => (
              <article class="spec" data-reveal style={`--d: ${(i % 3) * 90}ms`}>
                <div class="spec__top">
                  <span class="spec__n">{n2(i, priceBands.length)}</span>
                  <span class="card__icon">
                    <Icon name={p.icon} />
                  </span>
                </div>
                <h3 class="h3">{p.scope}</h3>
                <p class="spec__price">{p.range}</p>
                <p>{p.text}</p>
              </article>
            ))}
          </div>
          <p class="muted spec__note" data-reveal data-ph={ph('prices')}>
            {priceNote}
          </p>
        </div>
      </section>
    )
  }

  <section class="section section--tight">
    <div class="container"><Guarantee /></div>
  </section>

  <Cta />
</Base>
