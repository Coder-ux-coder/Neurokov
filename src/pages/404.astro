---
import Button from '../components/Button.astro';
import Clip from '../components/Clip.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Neurokov" description="This page doesn’t exist." noindex>
  <section class="page-hero lost" data-hold>
    <div class="gridlines" aria-hidden="true"></div>
    <div class="container page-hero__inner">
      <div class="runhead" data-reveal>
        <span class="label label--signal"><span data-decode>Error</span></span>
        <span class="runhead__line draw" aria-hidden="true"></span>
        <span class="label runhead__meta">Page not found</span>
      </div>
      <div class="split lost__split">
        <div class="split__copy">
          <h1 class="h1" data-reveal data-split>This link went cold. Your leads won’t.</h1>
          <p class="lead" data-reveal style="--d: 200ms">
            The page you’re looking for has moved or never existed. Head back home, or book the free audit while you’re
            here.
          </p>
          <div class="lost__cta" data-reveal style="--d: 280ms">
            <Button href="/" label="Back to home" size="lg" />
            <Button variant="ghost" size="lg" />
          </div>
        </div>
        <div class="split__media marks" data-reveal style="--d: 160ms">
          <Clip name="not-found" sizes="(max-width: 900px) 100vw, 620px" eager />
        </div>
      </div>
    </div>
  </section>
</Base>
