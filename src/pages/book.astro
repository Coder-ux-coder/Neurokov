---
import BookingForm from '../components/BookingForm.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/icons';
import SectionHead from '../components/SectionHead.astro';
import { site, unconfirmed } from '../data/site';
import Base from '../layouts/Base.astro';

const expect = [
  'Where your leads go cold today',
  'Where your next clients will come from',
  'A straight answer on what it would cost',
  'No pitch deck, no pressure, and a clear “not a fit” if we aren’t',
];

const next: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'eye',
    title: 'Before the call',
    text: 'We look at your business before we meet: your website, what you sell and how leads reach you. The 30 minutes go on your problems, not the basics.',
  },
  {
    icon: 'calendar-check',
    title: 'On the call',
    text: 'We look at where your clients come from, how fast your leads hear back and what happens to the ones who don’t buy, then show you the fastest route to more booked calls.',
  },
  {
    icon: 'file-signature',
    title: 'After the call',
    text: 'If there’s a fit, you get a written plan with one fixed price. If there isn’t, we’ll say so, and the advice is still yours to keep.',
  },
];

const forYou = [
  'You run a B2B service business and want more clients',
  'Your pipeline runs on referrals, so some months go quiet',
  'Leads wait hours for a reply, or slip through entirely',
  'You want booked calls, not another report or tool to manage',
];

const notForYou = [
  'You need a website, an app or someone to run your ads',
  'You want “more traffic” without wanting more clients',
  'You’re shopping for the cheapest quote, not results',
];

const bookingReady = !unconfirmed.has('booking');
---

<Base
  title={`Book a Free Growth Audit | ${site.name}`}
  description="Book a free, 30-minute growth audit. We’ll find where your leads go cold and show you exactly where your next clients will come from."
  bookingDialog={false}
>
  <section class="page-hero" data-hold>
    <div class="gridlines" aria-hidden="true"></div>
    <div class="container">
      <div class="runhead" data-reveal>
        <span class="label label--signal"><span data-decode>Free growth audit</span></span>
        <span class="runhead__line draw" aria-hidden="true"></span>
        <span class="label runhead__meta">30 minutes · Google Meet</span>
      </div>
      <div class="book">
        <div class="book__copy">
          <h1 class="h1" data-reveal data-split>Find out where your next clients are.</h1>
          <p class="lead" data-reveal style="--d: 200ms">
            A 100% free, 30-minute growth audit. Tell us about your business, pick a time, and we’ll come prepared.
          </p>
          <div data-reveal style="--d: 280ms">
            <span class="label">On the call</span>
            <ul class="checks book__list">
              {
                expect.map((e) => (
                  <li>
                    <Icon name="check" size={18} />
                    {e}
                  </li>
                ))
              }
            </ul>
          </div>
          <p class="cta__note" data-reveal style="--d: 340ms">
            <Icon name="shield-check" size={18} /> If we don’t deliver, you don’t pay.
          </p>
        </div>
        <div class="book__cal marks" data-reveal style="--d: 160ms">
          <div class="book__bar label" aria-hidden="true">
            <span>Book your audit</span>
            <span class:list={[{ 'is-off': !bookingReady }]}>{bookingReady ? 'Live' : 'Not connected'}</span>
          </div>
          <BookingForm mode="inline" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--deep">
    <div class="container">
      <SectionHead label="What happens next" title="What happens after you book." />
      <ol class="timeline timeline--3" data-reveal="none">
        {
          next.map((n, i) => (
            <li class="timeline__step" style={`--i: ${i}`}>
              <div class="timeline__meta">
                <span class="step__n">
                  <b>0{i + 1}</b>
                </span>
                <span class="card__icon">
                  <Icon name={n.icon} />
                </span>
              </div>
              <h3 class="h3">{n.title}</h3>
              <p>{n.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        label="Fit check"
        title="Is this call for you?"
        lead="We’d rather tell you now than waste your 30 minutes."
      />
      <div class="grid-2 compare">
        <article class="card card--us" data-reveal>
          <span class="label">Yes</span>
          <h3 class="h3">It’s for you if</h3>
          <ul>
            {
              forYou.map((f) => (
                <li>
                  <Icon name="check" size={18} />
                  <span>{f}</span>
                </li>
              ))
            }
          </ul>
        </article>
        <article class="card" data-reveal style="--d: 90ms">
          <span class="label">No</span>
          <h3 class="h3">It’s probably not if</h3>
          <ul>
            {
              notForYou.map((f) => (
                <li>
                  <Icon name="x" size={18} />
                  <span>{f}</span>
                </li>
              ))
            }
          </ul>
        </article>
      </div>
      <div class="center-cta" data-reveal>
        <Button size="lg" label="Claim your free audit" />
      </div>
    </div>
  </section>
</Base>
