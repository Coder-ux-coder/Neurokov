---
import Clip from '../components/Clip.astro';
import Cta from '../components/Cta.astro';
import Flap from '../components/Flap.astro';
import Guarantee from '../components/Guarantee.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/icons';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import { steps } from '../data/process';
import Base from '../layouts/Base.astro';

const dayOne: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'eye',
    title: 'Messaging you approve',
    text: 'Every message is written with you and approved before it goes out. No surprises in your prospects’ inboxes.',
  },
  {
    icon: 'mail',
    title: 'Inboxes warmed before launch',
    text: 'The slow part of outbound, warming up new sending inboxes, happens before launch, so day one is a real sending day.',
  },
  {
    icon: 'timer',
    title: 'Replies in under a minute',
    text: 'From the first lead after launch, every enquiry gets a personal reply in under 60 seconds.',
  },
  {
    icon: 'trending-up',
    title: 'Numbers from the first day',
    text: 'Replies, booked calls and new clients are tracked from day one, so you always know what you’re getting.',
  },
];

const needs = [
  'A short call to learn who you sell to and what makes you different',
  'Your approval on the messaging before it goes out',
  'A calendar we can book the calls onto',
  'Someone to show up and take the calls',
];
---

<Base
  title="Our Process | Neurokov"
  description="How working with Neurokov goes: a free growth audit, a fixed-price plan, a launch that books calls from day one, and an optional monthly plan to scale what works."
>
  <PageHero
    label="Our process"
    meta="04 steps"
    title="Four steps. No guesswork."
    lead="No 40-slide decks and no six-month roadmaps. Here’s exactly what working with us looks like, from the free audit to calls on your calendar."
    cta="Start with step one"
    promise="And step one is free."
  />

  <section class="section" style="padding-top: 0">
    <div class="container scrolly" data-scrolly>
      <div class="scrolly__pin">
        <span class="label label--signal">You are at step</span>
        <div class="board" data-dark>
          <div class="board__cell">
            <Flap value="01" />
            <span class="board__label" data-step-name>{steps[0].title}</span>
          </div>
        </div>
        <div class="scrolly__rail" data-rail><span></span></div>
        <p class="label">Scroll to walk through a project</p>
      </div>
      <ol class="scrolly__steps">
        {
          steps.map((s, i) => (
            <li class="scrolly__step" data-step={s.title}>
              <div class="scrolly__head">
                <span class="step__n">
                  Step <b>0{i + 1}</b>
                </span>
                <span class="tag">{s.tag}</span>
                <span class="card__icon">
                  <Icon name={s.icon} />
                </span>
              </div>
              <h2 class="h2 scrolly__title">{s.title}</h2>
              <p class="lead">{s.text}</p>
              <Clip name={s.clip} class="scrolly__film" sizes="(max-width: 900px) 100vw, 760px" />
              <p class="muted">{s.detail}</p>
              <div class="scrolly__get">
                <span class="label">What you get</span>
                <ul class="checks">
                  {s.get.map((g) => (
                    <li>
                      <Icon name="check" size={18} />
                      {g}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--ink" data-dark>
    <div class="container">
      <SectionHead
        label="Day one"
        title="Why results start on day one."
        lead="Plenty of agencies ask for 90 days before you see anything. We don’t, and here’s why."
      />
      <div class="grid-4">
        {
          dayOne.map((d, i) => (
            <article class="spec" data-reveal style={`--d: ${i * 90}ms`}>
              <div class="spec__top">
                <span class="spec__n">
                  {String(i + 1).padStart(2, '0')} / {String(dayOne.length).padStart(2, '0')}
                </span>
                <span class="card__icon">
                  <Icon name={d.icon} />
                </span>
              </div>
              <h3 class="h3">{d.title}</h3>
              <p>{d.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split split--top">
      <div class="split__copy">
        <SectionHead
          label="What we need from you"
          title="Less than you’d think."
          lead="You keep running the business while we bring the clients in. Here’s all we ask for."
        />
      </div>
      <ol class="numbered lead needs" data-reveal style="--d: 120ms">
        {needs.map((n) => <li>{n}</li>)}
      </ol>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container"><Guarantee /></div>
  </section>

  <Cta />
</Base>
