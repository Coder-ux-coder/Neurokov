---
/**
 * Step 2 for a visitor without JavaScript: the booking form posts its answers to Web3Forms,
 * which emails them to us and sends the visitor here to pick a time. With JavaScript, the
 * booking page takes the form's place instead (booking.ts). Kept out of search and the sitemap.
 */
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import { bookingEmbedUrl, bookingUrl, ph, site } from '../../data/site';
import Base from '../../layouts/Base.astro';
import '../../styles/booking.css';
---

<Base title={`Pick a time | ${site.name}`} description="Pick a time for your free growth audit." noindex boldMono={false} bookingDialog={false}>
  <PageHero
    label="Step 2 of 2 · Pick a time"
    meta="30 minutes · 100% free"
    title="Thanks. Now pick a time."
    lead="Your answers are with us. Choose a time for your free growth audit, and the invite comes to you by email."
  />
  <section class="section section--tight">
    <div class="container">
      {/* Every booking button on this page brings it into view (Button.astro, booking.ts). */}
      <div class="book__cal booking-time booking-time--page" id="pick" data-booking-page tabindex="-1" data-ph={ph('booking')}>
        <div class="booking-time__frame">
          <iframe src={bookingEmbedUrl} title="Pick a time for your free growth audit"></iframe>
        </div>
        <p class="cta__note booking__note">
          <Icon name="calendar-check" size={16} />
          <a class="text-link" href={bookingUrl} target="_blank" rel="noopener">Open the booking page in a new tab</a>
        </p>
      </div>
    </div>
  </section>
</Base>
