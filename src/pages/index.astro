---
/**
 * The landing page, laid out like LeftClick's (the user's model) and kept to the point: who we
 * are and the guarantee, the intro video, the real numbers, the tools we work with, the psychology
 * platform as the featured case (with its co-founder's words), the rest of the work, the founder,
 * the process, the guarantee, questions and one thing to do: book the free audit.
 */
import Board from '../components/Board.astro';
import Button from '../components/Button.astro';
import CaseCard from '../components/CaseCard.astro';
import Clip from '../components/Clip.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import Figure from '../components/Figure.astro';
import Founder from '../components/Founder.astro';
import Guarantee from '../components/Guarantee.astro';
import Icon from '../components/Icon.astro';
import Marquee from '../components/Marquee.astro';
import SectionHead from '../components/SectionHead.astro';
import Steps from '../components/Steps.astro';
import Vsl from '../components/Vsl.astro';
import { cases } from '../data/cases';
import { clips } from '../data/clips';
import { homeFaqs } from '../data/faqs';
import { site } from '../data/site';
import Base from '../layouts/Base.astro';

// On the homepage only: the name Google shows for the site in its results.
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: `${site.url}/` };
const at = (n: number) => `${String(n).padStart(2, '0')} / 05`;

// The featured case: the psychology platform Mohid co-founded. The rest follow as cards.
const featured = cases.find((c) => c.slug === 'psychology-platform')!;
const more = cases.filter((c) => c !== featured);
---

<Base jsonLd={website} signs>
  <!-- Hero: who we are, the guarantee first, the intro video and the one thing to do -->
  <section class="hero" data-hold>
    <div class="gridlines" aria-hidden="true"></div>
    <div class="container">
      <div class="runhead" data-reveal>
        <span class="label label--signal"><span data-decode>Lead generation agency</span></span>
        <span class="runhead__line draw" aria-hidden="true"></span>
        <span class="label runhead__meta">For B2B service businesses</span>
      </div>
      <h1 class="display hero__title" data-reveal data-split>
        Your lead generation partner<span class="accent-mark">.</span>
      </h1>
      <p class="promise" data-reveal style="--d: 140ms">
        <Icon name="shield-check" size={22} />
        <span><mark>If it doesn’t work, you don’t pay.</mark> And the audit is 100% free.</span>
      </p>
      <div class="hero__row">
        <div class="hero__copy">
          <div class="hero__pitch">
            <p class="lead" data-reveal style="--d: 260ms">
              We find the businesses that should buy from you, answer every lead in under a minute and put qualified sales
              calls on your calendar. You show up and close.
            </p>
            <div class="hero__cta" data-reveal style="--d: 360ms">
              <Button size="lg" label="Book your free audit" />
              <p class="cta__note">
                <Icon name="calendar-check" size={16} /> 30 minutes on Google Meet, free. You leave knowing where your next
                clients are.
              </p>
            </div>
          </div>
        </div>
        <div class="hero__media" data-reveal="clip" style="--d: 200ms"><Vsl /></div>
      </div>
      <div class="hero__board"><Board /></div>
    </div>
  </section>

  <Marquee />

  <!-- 01 The featured case: the psychology platform -->
  <section class="section">
    <div class="container split split--top">
      <div class="split__copy">
        <div class="section-head__rule" data-reveal>
          <span class="label label--signal"><span data-decode>Featured work</span></span>
          <span class="label">{at(1)}</span>
        </div>
        <h2 class="h2" data-reveal data-split>A psychology platform, grown 100%+ in a single month.</h2>
        <p class="lead" data-reveal style="--d: 120ms">{featured.summary}</p>
        <ul class="checks lead" data-reveal style="--d: 160ms">
          {
            featured.outcomes.map((o) => (
              <li>
                <Icon name="check" size={20} />
                {o}
              </li>
            ))
          }
        </ul>
        <div data-reveal style="--d: 200ms">
          <Button href={`/case-studies/${featured.slug}/`} label="Read the full case" variant="ghost" />
        </div>
      </div>
      <div class="split__media" data-reveal style="--d: 120ms">
        <Figure n="01" class="fig--film" caption={`${clips[featured.clip].title}. Illustrated, with this case’s real numbers.`}>
          <div class="marks">
            <Clip name={featured.clip} sizes="(max-width: 900px) 100vw, 620px" />
          </div>
        </Figure>
        {
          featured.quote && (
            <figure class="card quote quote--feature" data-reveal style="--d: 200ms">
              <blockquote>
                <p>{featured.quote.text}</p>
              </blockquote>
              <figcaption>
                <b>{featured.quote.by}</b>
              </figcaption>
            </figure>
          )
        }
      </div>
    </div>
  </section>

  <!-- 02 More of the work -->
  <section class="section section--deep">
    <div class="container">
      <SectionHead
        label="Our work"
        index={at(2)}
        title="Some of our work."
        lead="Real businesses, real numbers. Every result here was delivered by us."
      >
        <a slot="after-lead" class="text-link" href="/case-studies/"> Read the case studies<Icon name="arrow-right" size={16} class="text-link__arrow" /></a>
      </SectionHead>
      <div class="cases cases--2">
        {more.map((c, i) => <CaseCard study={c} delay={i * 100} />)}
      </div>
    </div>
  </section>

  <!-- 03 The founder -->
  <section class="section">
    <div class="container">
      <SectionHead
        label="Who’s behind it"
        index={at(3)}
        title="Doing this since 2020."
        lead="Neurokov is new. The experience behind it isn’t."
      />
      <Founder film="02" />
    </div>
  </section>

  <!-- 04 How it works -->
  <section class="section section--deep">
    <div class="container">
      <SectionHead
        label="How it works"
        index={at(4)}
        title="From first call to booked calls."
        lead="One free call, one fixed price and booked calls from day one."
      >
        <a slot="after-lead" class="text-link" href="/process/"> See the process in detail<Icon name="arrow-right" size={16} class="text-link__arrow" /></a>
      </SectionHead>
      <Steps />
    </div>
  </section>

  <section class="section section--tight">
    <div class="container"><Guarantee /></div>
  </section>

  <!-- 05 FAQ -->
  <section class="section">
    <div class="container faq-layout">
      <div class="faq-layout__head">
        <SectionHead label="Questions" index={at(5)} title="Questions, answered." />
        <p class="muted" data-reveal>
          More on pricing, the guarantee and your data in the <a class="text-link" href="/faq/">full FAQ</a>.
        </p>
      </div>
      <Faq items={homeFaqs} />
    </div>
  </section>

  <Cta />
</Base>
