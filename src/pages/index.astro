---
/**
 * The landing page, kept short on purpose: the video (or the case reel until it's recorded), the
 * process at a glance, the work we've done (and what clients say, once there are quotes), the
 * guarantee and one thing to do: book the free audit.
 */
import Board from '../components/Board.astro';
import Button from '../components/Button.astro';
import CaseCard from '../components/CaseCard.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import Guarantee from '../components/Guarantee.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import Steps from '../components/Steps.astro';
import Testimonials from '../components/Testimonials.astro';
import Vsl from '../components/Vsl.astro';
import { cases } from '../data/cases';
import { homeFaqs } from '../data/faqs';
import { site } from '../data/site';
import { testimonials } from '../data/testimonials';
import Base from '../layouts/Base.astro';

// On the homepage only: the name Google shows for the site in its results.
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: `${site.url}/` };
const total = testimonials.length ? 4 : 3;
const at = (n: number) => `${String(n).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
---

<Base jsonLd={website}>
  <!-- Hero: the promise, the video and the one thing to do -->
  <section class="hero" data-hold>
    <div class="gridlines" aria-hidden="true"></div>
    <div class="container">
      <div class="runhead" data-reveal>
        <span class="label label--signal"><span data-decode>Lead generation agency</span></span>
        <span class="runhead__line draw" aria-hidden="true"></span>
        <span class="label runhead__meta">Est. 2020 · For B2B service businesses</span>
      </div>
      <h1 class="display hero__title" data-reveal data-split>
        Your next clients, booked for you<span class="accent-mark">.</span>
      </h1>
      <p class="promise" data-reveal style="--d: 140ms">
        <Icon name="shield-check" size={22} />
        <span><mark>If we don’t deliver, you don’t pay.</mark> And the audit is 100% free.</span>
      </p>
      <div class="hero__row">
        <div class="hero__copy">
          <div class="hero__pitch">
            <p class="lead" data-reveal style="--d: 260ms">
              We find the businesses that should buy from you, answer every lead in under a minute and put qualified sales
              calls on your calendar. You show up and close.
            </p>
            <div class="hero__cta" data-reveal style="--d: 360ms">
              <Button size="lg" label="Book your free audit" />
              <p class="cta__note">
                <Icon name="calendar-check" size={16} /> 30 minutes, free. You leave knowing where your next clients are.
              </p>
            </div>
          </div>
        </div>
        <div class="hero__media" data-reveal="clip" style="--d: 200ms"><Vsl /></div>
      </div>
      <div class="hero__board"><Board /></div>
    </div>
  </section>

  <!-- 01 How it works -->
  <section class="section section--deep">
    <div class="container">
      <SectionHead
        label="How it works"
        index={at(1)}
        title="Four steps to a full calendar."
        lead="One free call, one fixed price and booked calls from day one. Here’s the whole thing."
      >
        <a slot="after-lead" class="text-link" href="/process/"> See the process in detail →</a>
      </SectionHead>
      <Steps />
    </div>
  </section>

  <!-- 02 Work -->
  <section class="section">
    <div class="container">
      <SectionHead
        label="Our work"
        index={at(2)}
        title="Projects we’ve delivered."
        lead="Real businesses, real numbers. Every result here was delivered by us."
      >
        <a slot="after-lead" class="text-link" href="/case-studies/"> Read the case studies →</a>
      </SectionHead>
      <div class="cases">
        {cases.map((c, i) => <CaseCard study={c} delay={i * 100} />)}
      </div>
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section class="section section--deep">
        <div class="container">
          <SectionHead label="In their words" index={at(3)} title="What clients say." />
          <Testimonials />
        </div>
      </section>
    )
  }

  <section class="section section--tight">
    <div class="container"><Guarantee /></div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container faq-layout">
      <div class="faq-layout__head">
        <SectionHead label="Questions" index={at(total)} title="Questions, answered." />
        <p class="muted" data-reveal>
          More on pricing, the guarantee and your data in the <a class="text-link" href="/faq/">full FAQ</a>.
        </p>
      </div>
      <Faq items={homeFaqs} />
    </div>
  </section>

  <Cta />
</Base>
